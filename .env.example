# ==========================================
# kholod-site Docker Environment Variables
# ==========================================

# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ------------------------------------------
# Strapi Backend Configuration
# ------------------------------------------

# Generate APP_KEYS with: openssl rand -base64 32 (run 4 times, comma-separated)
# Example: STRAPI_APP_KEYS="key1,key2,key3,key4"
STRAPI_APP_KEYS=

# Generate with: openssl rand -base64 32
STRAPI_API_TOKEN_SALT=

# Generate with: openssl rand -base64 32
STRAPI_ADMIN_JWT_SECRET=

# Generate with: openssl rand -base64 32
STRAPI_TRANSFER_TOKEN_SALT=

# Generate with: openssl rand -base64 32
STRAPI_JWT_SECRET=

# Generate with: openssl rand -base64 32
STRAPI_ENCRYPTION_KEY=

# ------------------------------------------
# Frontend Configuration
# ------------------------------------------

# Resend API key for email functionality
# Get from: https://resend.com/api-keys
RESEND_API_KEY=

# Admin contact email
ADMIN_EMAIL=

# System sender email (must be verified in Resend)
SYSTEM_EMAIL=
